# These VITE_ values are public and embedded in the browser bundle.
VITE_BRAND_NAME=10X Social
VITE_CANONICAL_URL=https://10x.social

# Independent identity switch. Edit whitelabel/ first; starters copy upstream.
# This remains active even when VITE_10X_FEATURES=false. Rebuild after changing.
VITE_10X_FEATURE_WHITELABEL=false

# Master switch for optional 10X product features.
VITE_10X_FEATURES=true

# Granular 10X feature flags. Set to false and rebuild for a feature rollback.
VITE_10X_FEATURE_ANIMATED_AVATARS=true
VITE_10X_FEATURE_KLIPY_MEDIA_PICKER=true

# Public browser application key. This value is embedded in the JavaScript
# bundle; restrict it to the 10X origins in KLIPY's partner dashboard if
# origin restrictions are available.
VITE_KLIPY_API_KEY=

# Public project id from Reown Cloud. Leave blank to offer injected and
# Coinbase browser wallets without WalletConnect QR support.
VITE_WALLETCONNECT_PROJECT_ID=

# Keep the migration flow on Farcaster's official origin.
VITE_FARCASTER_WALLET_EXPORT_URL=https://wallet-export.farcaster.xyz/
